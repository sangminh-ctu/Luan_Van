PORT=5000
NODE_ENV=development

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=
# Optional Gemini question parsing for the book chatbot (backend only).
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=
# Optional secondary provider and one transient retry inside the request deadline.
AI_FALLBACK_PROVIDER=
AI_RETRY_ONCE=false
AI_TIMEOUT_MS=
# Optional per-call timeout override in milliseconds, capped by the chatbot.
GEMINI_TIMEOUT_MS=
# VNPAY Sandbox (backend only). Never put the hash secret in VITE_* variables.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/vnpay/return
FRONTEND_URL=http://localhost:5173
VNPAY_PAYMENT_MINUTES=15
# Opt-in fallback for localhost Sandbox only; public deployments always use IPN.
VNPAY_SANDBOX_RETURN_CONFIRMATION=false
ADMIN_PASSWORD=
JWT_SECRET=
